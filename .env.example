# Anvil CLI environment
# Copy this to `.env` (or export the vars) before running the CLI.

# ── Model API keys (need at least one; picker or --model chooses) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
GLM_API_KEY=

# ── Optional: agentic context ────────────────────────────────────────────────
# Tavily gives higher-quality @web: results; DuckDuckGo scraping is used otherwise.
TAVILY_API_KEY=

# ── EmbeddingService (semantic_search tool) ──────────────────────────────────
# Optional. If unset, semantic_search falls back to TF-IDF cosine similarity.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3

# ── Ports (only used if the services were ever wrapped in an HTTP layer;
# ── the current implementation is fully in-process. Kept for forward-compat.)
EMBEDDING_SERVICE_PORT=8001
VALIDATION_ENGINE_PORT=8002
