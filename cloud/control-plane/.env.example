DATABASE_URL=postgresql://user:password@localhost:5432/anvil_cloud
REDIS_URL=redis://localhost:6379
# Separate connection used exclusively for pub/sub subscriptions.
# Can be the same URL as REDIS_URL; ioredis still uses a distinct socket.
REDIS_SUBSCRIBER_URL=redis://localhost:6379
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DASHBOARD_ORIGIN=http://localhost:3000
PORT=3001

# VM driver: 'docker' for local dev, 'firecracker' for production.
VM_DRIVER=docker

# Warm VM pool: number of pre-booted VMs to keep ready for instant session start.
# Set to 0 to disable (all sessions boot on demand).
VM_POOL_SIZE=2

# Firecracker (production only):
VM_BASE_IMAGE_PATH=/var/lib/anvil/base.ext4
FIRECRACKER_BINARY=/usr/local/bin/firecracker

# Model provider API keys forwarded into each VM.
# ANTHROPIC_API_KEY is the default the CLI reaches for; the others are used
# when the user picks a matching provider from the model picker.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
GLM_API_KEY=
