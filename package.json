{
  "name": "anvil-agent",
  "version": "1.0.3",
  "description": "A terminal-based AI coding agent",
  "type": "module",
  "bin": {
    "anvilai": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc --outDir dist && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "compile": "bun build --compile --target=bun --outfile=bin/anvilai src/index.ts",
    "compile:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 --outfile=bin/anvilai-darwin-arm64 src/index.ts",
    "compile:darwin-x64": "bun build --compile --target=bun-darwin-x64 --outfile=bin/anvilai-darwin-x64 src/index.ts",
    "compile:linux-x64": "bun build --compile --target=bun-linux-x64 --outfile=bin/anvilai-linux-x64 src/index.ts",
    "compile:windows-x64": "bun build --compile --target=bun-windows-x64 --outfile=bin/anvilai-windows-x64.exe src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@types/figlet": "^1.7.0",
    "@types/micromatch": "^4.0.10",
    "@types/react": "^19.2.17",
    "chalk": "^5.6.2",
    "diff": "^9.0.0",
    "execa": "^9.4.0",
    "figlet": "^1.11.0",
    "ink": "^6.8.0",
    "micromatch": "^4.0.8",
    "openai": "^4.68.0",
    "react": "^19.2.7",
    "simple-git": "^4.0.2",
    "tree-sitter": "^0.21.1",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^5.6.0",
    "typescript-language-server": "^5.3.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript-eslint": "^8.0.0"
  },
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./package.json": "./package.json"
  }
}
